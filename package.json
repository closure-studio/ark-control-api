{
  "name": "ark-control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ci": "npm run db:check && npm run db:verify && npm run typecheck && npm test && npm run build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:verify": "node scripts/verify-drizzle-migrations.mjs",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^25.9.3",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260708.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.110.0"
  }
}
