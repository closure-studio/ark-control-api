{
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
